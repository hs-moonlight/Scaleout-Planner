# Copy to .env and fill in. Never commit .env (it's git-ignored).

# --- Market data (free tiers) ---
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# --- Database ---
# Local dev: SQLite (default below).
DATABASE_URL=sqlite:///./scaleout.db
# Azure: use PostgreSQL instead, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# (postgres:// and postgresql:// are auto-normalized to the psycopg driver.)

# --- Strategy default ---
DEFAULT_STOP_PCT=6.0

# --- CORS (front end is same-origin, so "*" is fine locally) ---
CORS_ORIGINS=*

# In production, set these as App Service application settings / Key Vault
# references — do NOT deploy a real .env file.
