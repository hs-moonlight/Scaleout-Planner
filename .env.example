# Copy to .env and fill in. Never commit .env (it's git-ignored).

# --- Market data (free tiers) ---
# Alpha Vantage: broad symbol coverage + the weekly OHLC series we need for
# ATR / 40-week SMA. Small daily cap (~25 calls/day free).
ALPHA_VANTAGE_API_KEY=
# Financial Modeling Prep: rich quote (price + 50/200-day MA + 52wk range) and
# analyst consensus + price targets. Free plan gates many symbols (HTTP 402).
FMP_API_KEY=
# Finnhub (optional): broad analyst recommendation coverage + backstop price.
# Leave blank to disable; the dispatcher simply skips it.
FINNHUB_API_KEY=

# --- Provider order per capability (comma-separated; first that answers wins) ---
QUOTE_PROVIDERS=fmp,finnhub,alpha_vantage
ANALYST_PROVIDERS=fmp,finnhub
SERIES_PROVIDERS=alpha_vantage

# --- In-memory cache TTLs (seconds; 0 disables) ---
CACHE_TTL_QUOTE=60
CACHE_TTL_ANALYST=21600
CACHE_TTL_SERIES=21600

# --- Database ---
# Local dev: SQLite (default below).
DATABASE_URL=sqlite:///./scaleout.db
# Azure: use PostgreSQL instead, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# (postgres:// and postgresql:// are auto-normalized to the psycopg driver.)

# --- Strategy default ---
DEFAULT_STOP_PCT=6.0

# --- CORS (front end is same-origin, so "*" is fine locally) ---
CORS_ORIGINS=*

# In production, set these as App Service application settings / Key Vault
# references — do NOT deploy a real .env file.
